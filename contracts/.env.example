# ----------------------------------------------------------------------------
# IP Inscription — contracts environment (contracts/.env)
# Used by Foundry for deploying to a testnet. NEVER commit real secrets.
# Load with: `source .env` (or `export $(grep -v '^#' .env | xargs)`).
# ----------------------------------------------------------------------------

# RPC endpoints (Alchemy recommended).
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>

# Deployer private key (a throwaway TESTNET key holding only testnet ETH).
# Must be 0x-prefixed. DO NOT use a key that holds real funds.
PRIVATE_KEY=0xyour_testnet_private_key

# Optional: for `--verify` on Basescan/Etherscan.
ETHERSCAN_API_KEY=
