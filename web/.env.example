# ----------------------------------------------------------------------------
# IP Inscription — frontend environment (web/.env.local)
# Copy this file to web/.env.local and fill in the values. NEVER commit secrets.
# ----------------------------------------------------------------------------

# Testnet chain id. 84532 = Base Sepolia (preferred), 11155111 = Sepolia.
NEXT_PUBLIC_CHAIN_ID=84532

# Deployed IPInscriptionRegistry address (set after you run the deploy script).
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# RPC endpoint for reads + wallet writes. Use an Alchemy Base Sepolia URL, e.g.
# https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
NEXT_PUBLIC_RPC_URL=

# Public IPFS gateway used to display pinned content (trailing slash optional).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# WalletConnect Cloud project id (free): https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- SERVER ONLY (not exposed to the browser) ----
# Pinata JWT used by the /api/ipfs routes to pin files + metadata.
# Create one at https://app.pinata.cloud (API Keys -> New Key -> JWT).
PINATA_JWT=
